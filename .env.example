# Copy to .env and fill in locally. .env is git-ignored and must never be committed.
# Only the local server process reads these values.
# To keep the key file outside the repository instead, start the server with
# YOUCAM_ENV_FILE=/path/to/your.env npm start

# fake   = deterministic synthetic responses, no network (what the tests use)
# replay = real responses recorded from earlier live calls, no network, no key needed
# live   = real YouCam API calls; needs YOUCAM_API_KEY
YOUCAM_MODE=replay

# Your own key from the YouCam API console's API Key tab. It stays on the local server:
# never sent to the browser, never written to a log or a fixture.
YOUCAM_API_KEY=

# The API server named in the YouCam developer docs.
YOUCAM_API_BASE=https://yce-api-01.makeupar.com

# The most units a single shade check may spend. The whole check is priced before the photo
# is uploaded: 29 units plus up to 3 per foundation in the cart (38 for three).
# Only the merchant verb set_unit_cap changes it at runtime; the agent cannot.
UNIT_CAP_PER_CHECK=40

# Local port. The server binds to 127.0.0.1 only.
PORT=5178
